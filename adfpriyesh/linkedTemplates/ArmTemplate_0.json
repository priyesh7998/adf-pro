							{
								"activity": "Total_records",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(activity('Total_records').output.resultSets[0].rows[0].total_records,1)",
