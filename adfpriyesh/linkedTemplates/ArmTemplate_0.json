								{
									"type": "Query",
									"text": {
										"value": "SELECT COUNT(*) AS total_records FROM @{pipeline().parameters.schema}.@{pipeline().parameters.table} WHERE last_updated > '@{if(empty(pipeline().parameters.backdate),activity('Lookup').output.firstRow.cdc_timestamp,pipeline().parameters.backdate)}'",
