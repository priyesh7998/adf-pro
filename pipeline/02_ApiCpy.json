{
	"name": "02_ApiCpy",
	"properties": {
		"activities": [
			{
				"name": "WebApiLink",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://pokeapi.co/api/v2/pokemon"
				}
			},
			{
				"name": "CopyData",
				"description": "Here We Choose Other \"Pagination rules\n\" to copy data from api\nsee_  Source section - Pagination rules\n\nThis will copy all from each page of  API URL",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"AbsoluteUrl": "$.next"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ls_api_data_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "sink_api",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "CopyData_copy",
				"description": "Here We Choose Other \"Pagination rules\n\" to copy data from api\nsee_  Source section - Pagination rules\n\nThis will copy all from each page of  API URL",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "WebApiLink",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"QueryParameters.offset": {
								"value": "RANGE:0:@{activity('WebApiLink').output.count}:20",
								"type": "Expression"
							}
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ls_api_data_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "sink_api",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "___REVISIONS"
		},
		"annotations": []
	}
}